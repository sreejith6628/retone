{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retone",
  "version": "0.1.0",
  "identifier": "app.retone.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "pill",
        "url": "index.html",
        "title": "Retone",
        "width": 128,
        "height": 30,
        "x": 896,
        "y": 8,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Rewrite selected text anywhere with your own AI subscription",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Sreejith"
  }
}